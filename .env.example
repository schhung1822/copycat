# ==========================================================
#  DESIGN COPYCAT AI - CẤU HÌNH MÔI TRƯỜNG
#  Copy file này thành `.env` rồi điền thông tin thật.
# ==========================================================

# ---------- 1. SERVER ----------
PORT=4000
# Địa chỉ lắng nghe. Chạy sau nginx trên VPS thì đặt 127.0.0.1 để không lộ cổng Node ra Internet.
HOST=0.0.0.0
# URL public của web. Khi chạy thật đổi thành https://tenmien-cua-ban.com
APP_URL=http://localhost:3000
# Đặt production khi chạy thật (bắt buộc có HTTPS, xem mục Deploy trong README)
NODE_ENV=development

# ---------- 2. DATABASE (MySQL / MariaDB) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=copycat_ai
# Server sẽ tự tạo database + bảng nếu chưa có (đặt false nếu bạn tự quản lý schema)
DB_AUTO_MIGRATE=true

# ---------- 3. BẢO MẬT ----------
# BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài khi chạy thật.
# Gợi ý sinh nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi_chuoi_nay_thanh_mot_chuoi_ngau_nhien_that_dai
JWT_EXPIRES_IN=7d

# ---------- 4. TÀI KHOẢN ADMIN ----------
# Danh sách email có quyền admin, phân tách bằng dấu phẩy.
# Ai đăng ký bằng email nằm trong danh sách này sẽ tự động là admin.
# Thêm email vào đây rồi restart server là tài khoản đó lên admin ngay (không cần sửa DB).
ADMIN_EMAILS=admin@nextgenholdings.nl

# (Tuỳ chọn) Tự tạo sẵn 1 tài khoản admin khi khởi động lần đầu.
# Để trống nếu bạn muốn tự đăng ký qua giao diện.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------- 5. NHÀ CUNG CẤP AI (bên thứ 3) ----------
# API key Kie.ai - dùng chung cho toàn hệ thống, KHÔNG lộ ra client nữa.
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_UPLOAD_URL=https://kieai.redpandaai.co/api/file-base64-upload

# Tỉ giá quy đổi USD -> VND dùng để tính chi phí vốn trong báo cáo admin
USD_TO_VND=28000

# ---------- 6. THANH TOÁN / NẠP TIỀN ----------
# Thông tin tài khoản nhận tiền (hiện trên trang nạp tiền + sinh mã QR VietQR)
BANK_CODE=MB
BANK_ACCOUNT_NUMBER=0000000000
BANK_ACCOUNT_NAME=NGUYEN VAN A
BANK_NAME=MB Bank
# Tiền tố mã đơn nạp, khách sẽ ghi mã này vào nội dung chuyển khoản
ORDER_PREFIX=NAP
# Số phút đơn nạp còn hiệu lực trước khi hết hạn
ORDER_EXPIRE_MINUTES=60

# --- Webhook tự động cộng token ---
# SePay: cấu hình webhook trỏ tới  {APP_URL}/api/webhooks/sepay
# và đặt "API Key" trong SePay trùng với giá trị dưới đây.
SEPAY_WEBHOOK_API_KEY=

# Casso v2: cấu hình webhook trỏ tới {APP_URL}/api/webhooks/casso
# và đặt "Secure Token" trùng giá trị dưới đây.
CASSO_WEBHOOK_SECURE_TOKEN=

# ---------- 7. LƯU TRỮ ẢNH ----------
# Thư mục lưu ảnh trên server (tương đối so với thư mục gốc dự án)
STORAGE_DIR=server/storage
# Tự tải ảnh kết quả từ nhà cung cấp về server (khuyến nghị true để link không hết hạn)
DOWNLOAD_RESULTS=true

# ---------- 8. GIỚI HẠN ----------
# Số job tạo ảnh chạy song song tối đa trên toàn hệ thống
MAX_CONCURRENT_JOBS=4
# Số ảnh tối đa 1 user được xếp hàng cùng lúc
MAX_QUEUE_PER_USER=12
